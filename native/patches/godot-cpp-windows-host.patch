--- a/tools/android.py
+++ b/tools/android.py
@@ -1,3 +1,4 @@
+import SCons.Action
 import os
 import sys
 
@@ -34,6 +35,23 @@ def get_android_ndk_root(env):
         return os.environ.get("ANDROID_NDK_ROOT")
 
 
+
+def _archive_with_response_file(target, source, env):
+    import subprocess, tempfile
+    rsp = tempfile.NamedTemporaryFile("w", suffix=".rsp", delete=False)
+    rsp.write(chr(10).join(str(f).replace(chr(92), "/") for f in source))
+    rsp.close()
+    out = str(target[0])
+    if os.path.exists(out):
+        os.remove(out)
+    ar = env.subst("$AR")
+    if not ar.endswith(".exe"):
+        ar += ".exe"
+    rc = subprocess.call([ar] + env.subst("$ARFLAGS").split() + [out, "@" + rsp.name])
+    os.remove(rsp.name)
+    return rc
+
+
 def generate(env):
     if get_android_ndk_root(env) is None:
         raise ValueError(
@@ -107,6 +125,9 @@ def generate(env):
     env["CXX"] = toolchain + "/bin/clang++"
     env["LINK"] = toolchain + "/bin/clang++"
     env["AR"] = toolchain + "/bin/llvm-ar"
+    if sys.platform == "win32":
+        # Buckdroid: about 1000 object files exceed Windows' command-line limit; archive them with a response file.
+        env["ARCOM"] = SCons.Action.Action(_archive_with_response_file, "$ARCOMSTR")
     env["AS"] = toolchain + "/bin/llvm-as"
     env["STRIP"] = toolchain + "/bin/llvm-strip"
     env["RANLIB"] = toolchain + "/bin/llvm-ranlib"
