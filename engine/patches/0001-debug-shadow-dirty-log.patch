 #include <new>
 
+// Buckdroid Roulette: development diagnostic. With the BUCKDROID_SHADOW_DEBUG environment variable set, logs (once
+// per 60 frames, up to 16 lines) which instances mark positional light shadows dirty, i.e. force them to be redrawn.
+#include "core/config/engine.h"
+#define BD_SHADOW_DIRTY_DEBUG(m_instance, m_why)                                                                  \
+	do {                                                                                                           \
+		static int bd_enabled = -1;                                                                                \
+		if (bd_enabled < 0) {                                                                                      \
+			bd_enabled = OS::get_singleton()->has_environment("BUCKDROID_SHADOW_DEBUG") ? 1 : 0;                   \
+		}                                                                                                          \
+		if (bd_enabled) {                                                                                          \
+			static uint64_t bd_frame = 0;                                                                          \
+			static int bd_count = 0;                                                                               \
+			uint64_t bd_f = Engine::get_singleton()->get_process_frames();                                         \
+			if (bd_f != bd_frame) {                                                                                \
+				bd_frame = bd_f;                                                                                   \
+				bd_count = 0;                                                                                      \
+			}                                                                                                      \
+			if ((bd_f % 60) == 0 && bd_count++ < 16) {                                                             \
+				print_line(vformat("[bd-shadow] frame %d %s: base_type %d at %s", (int64_t)bd_f, m_why,            \
+						(int)(m_instance)->base_type, (m_instance)->transform.origin));                            \
+			}                                                                                                      \
+		}                                                                                                          \
+	} while (false)
+
