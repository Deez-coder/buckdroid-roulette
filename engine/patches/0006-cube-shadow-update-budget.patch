From c0df4d4c368df31366f15b174569bed9d4b30d28 Mon Sep 17 00:00:00 2001
From: buckdroid <buckdroid@localhost>
Date: Mon, 23 Nov 2026 19:13:00 +0300
Subject: [PATCH] Buckdroid 0006: shadow-update budget for cube-shadow omni
 lights

---
 servers/rendering/renderer_scene_cull.cpp | 17 ++++++++++++-----
 servers/rendering_server.cpp              |  2 ++
 2 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/servers/rendering/renderer_scene_cull.cpp b/servers/rendering/renderer_scene_cull.cpp
index 247b7bd..63b326d 100644
--- a/servers/rendering/renderer_scene_cull.cpp
+++ b/servers/rendering/renderer_scene_cull.cpp
@@ -3274,13 +3274,20 @@ void RendererSceneCull::_render_scene(const RendererSceneRender::CameraData *p_c
 			if (bd_interval < 0) {
 				bd_interval = MAX(1, (int)GLOBAL_GET("rendering/lights_and_shadows/positional_shadow/buckdroid_paraboloid_update_interval"));
 			}
+			// Buckdroid (patch 0006): cube-shadow omni lights get their own interval,
+			// rendering/lights_and_shadows/positional_shadow/buckdroid_cube_update_interval (1 = every frame). A large
+			// cube light whose range covers moving characters otherwise redraws all six faces every frame.
+			static int bd_cube_interval = -1;
+			if (bd_cube_interval < 0) {
+				bd_cube_interval = MAX(1, (int)GLOBAL_GET("rendering/lights_and_shadows/positional_shadow/buckdroid_cube_update_interval"));
+			}
 			uint64_t bd_frame = Engine::get_singleton()->get_frames_drawn();
 			bool bd_deferred = false;
-			if (light->shadow_dirty && bd_interval > 1 &&
-					RSG::light_storage->light_get_type(ins->base) == RS::LIGHT_OMNI &&
-					RSG::light_storage->light_omni_get_shadow_mode(ins->base) == RS::LIGHT_OMNI_SHADOW_DUAL_PARABOLOID &&
-					bd_frame - light->bd_last_shadow_frame < (uint64_t)bd_interval) {
-				bd_deferred = true; // keep the change pending; the current shadow stays valid until then
+			if (light->shadow_dirty && RSG::light_storage->light_get_type(ins->base) == RS::LIGHT_OMNI) {
+				int bd_light_interval = RSG::light_storage->light_omni_get_shadow_mode(ins->base) == RS::LIGHT_OMNI_SHADOW_DUAL_PARABOLOID ? bd_interval : bd_cube_interval;
+				if (bd_light_interval > 1 && bd_frame - light->bd_last_shadow_frame < (uint64_t)bd_light_interval) {
+					bd_deferred = true; // keep the change pending; the current shadow stays valid until then
+				}
 			}
 
 			if (light->shadow_dirty && !bd_deferred) {
diff --git a/servers/rendering_server.cpp b/servers/rendering_server.cpp
index fe864f3..6d9b4fd 100644
--- a/servers/rendering_server.cpp
+++ b/servers/rendering_server.cpp
@@ -2897,6 +2897,8 @@ void RenderingServer::init() {
 	GLOBAL_DEF(PropertyInfo(Variant::INT, "display/window/buckdroid_preferred_refresh_rate", PROPERTY_HINT_RANGE, "0,240,1"), 0);
 	// Buckdroid: shadow-update budget for dual-paraboloid omni lights (1 = every frame, Godot's behaviour).
 	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/lights_and_shadows/positional_shadow/buckdroid_paraboloid_update_interval", PROPERTY_HINT_RANGE, "1,8,1"), 1);
+	// Buckdroid: shadow-update budget for cube-shadow omni lights (1 = every frame, Godot's behaviour).
+	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/lights_and_shadows/positional_shadow/buckdroid_cube_update_interval", PROPERTY_HINT_RANGE, "1,8,1"), 1);
 	GLOBAL_DEF("rendering/lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile", 0);
 
 	GLOBAL_DEF("rendering/2d/shadow_atlas/size", 2048);
-- 
2.53.0.windows.2

