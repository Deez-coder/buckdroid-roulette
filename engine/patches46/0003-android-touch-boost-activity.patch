From 3cc2c2ab62cdfe575aa737f20340a29da6d9cd53 Mon Sep 17 00:00:00 2001
From: buckdroid <buckdroid@localhost>
Date: Tue, 24 Nov 2026 11:43:38 +0300
Subject: [PATCH 3/4] Buckdroid 46-0003: touch-boost opt-out from GodotActivity
 (the 4.6 view has only the application context)

---
 .../java/org/godotengine/godot/GodotActivity.kt     | 12 ++++++++++++
 .../org/godotengine/godot/vulkan/VkSurfaceView.kt   | 13 +++++++++++--
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/platform/android/java/lib/src/main/java/org/godotengine/godot/GodotActivity.kt b/platform/android/java/lib/src/main/java/org/godotengine/godot/GodotActivity.kt
index e2fc0c5..aed58ed 100644
--- a/platform/android/java/lib/src/main/java/org/godotengine/godot/GodotActivity.kt
+++ b/platform/android/java/lib/src/main/java/org/godotengine/godot/GodotActivity.kt
@@ -120,6 +120,18 @@ abstract class GodotActivity : FragmentActivity(), GodotHost {
 
 		setContentView(getGodotAppLayout())
 
+		// Buckdroid: Android raises the refresh rate to the maximum on every touch ("touch boost"), which overrides the
+		// game's 60 Hz request on Samsung phones (seen as the panel returning to 120 Hz during play). Android 15+ lets
+		// the window opt out.
+		if (android.os.Build.VERSION.SDK_INT >= 35) {
+			try {
+				window.setFrameRateBoostOnTouchEnabled(false)
+				Log.i("godot", "[buckdroid] touch boost off")
+			} catch (e: Exception) {
+				Log.w("godot", "[buckdroid] touch boost: $e")
+			}
+		}
+
 		// Register `OnBackPressedCallback` for the Godot fragment.
 		onBackPressedDispatcher.addCallback { godotFragment?.onBackPressed() }
 
diff --git a/platform/android/java/lib/src/main/java/org/godotengine/godot/vulkan/VkSurfaceView.kt b/platform/android/java/lib/src/main/java/org/godotengine/godot/vulkan/VkSurfaceView.kt
index 6b364db..f729261 100644
--- a/platform/android/java/lib/src/main/java/org/godotengine/godot/vulkan/VkSurfaceView.kt
+++ b/platform/android/java/lib/src/main/java/org/godotengine/godot/vulkan/VkSurfaceView.kt
@@ -161,7 +161,7 @@ open internal class VkSurfaceView(context: Context) : SurfaceView(context), Surf
 			} catch (e: Exception) {
 				android.util.Log.w("godot", "[buckdroid] setFrameRate failed: $e")
 			}
-			disableTouchBoost()
+			// Touch boost is turned off in GodotActivity (the view only has the application context in 4.6).
 		}
 	}
 
@@ -174,7 +174,16 @@ open internal class VkSurfaceView(context: Context) : SurfaceView(context), Surf
 		if (android.os.Build.VERSION.SDK_INT < 35) {
 			return
 		}
-		val activity = context as? android.app.Activity ?: return
+		// In Godot 4.6 the view's context can be a ContextWrapper around the activity, so unwrap it.
+		var ctx: android.content.Context? = context
+		while (ctx is android.content.ContextWrapper && ctx !is android.app.Activity) {
+			ctx = ctx.baseContext
+		}
+		val activity = ctx as? android.app.Activity
+		if (activity == null) {
+			android.util.Log.w("godot", "[buckdroid] touch boost: no activity for $context")
+			return
+		}
 		try {
 			val m = activity.window.javaClass.getMethod("setFrameRateBoostOnTouchEnabled", Boolean::class.javaPrimitiveType)
 			activity.runOnUiThread {
-- 
