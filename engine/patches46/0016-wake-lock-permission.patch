From 2c8bfeefbc7a00c5f4bbd244482d5e833f311c95 Mon Sep 17 00:00:00 2001
From: buckdroid <buckdroid@localhost>
Date: Wed, 25 Nov 2026 19:17:15 +0300
Subject: [PATCH] Buckdroid: WAKE_LOCK permission for the low-latency Wi-Fi
 mode during multiplayer

---
 platform/android/java/app/src/main/AndroidManifest.xml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/platform/android/java/app/src/main/AndroidManifest.xml b/platform/android/java/app/src/main/AndroidManifest.xml
index 7587219..3b06a4f 100644
--- a/platform/android/java/app/src/main/AndroidManifest.xml
+++ b/platform/android/java/app/src/main/AndroidManifest.xml
@@ -18,6 +18,8 @@
     <!-- Buckdroid: multiplayer (peer-to-peer connections). Normal permissions: granted at install, no prompt. -->
     <uses-permission android:name="android.permission.INTERNET" />
     <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
+    <!-- Buckdroid: the low-latency Wi-Fi mode during multiplayer (a Wi-Fi lock). Normal permission, no prompt. -->
+    <uses-permission android:name="android.permission.WAKE_LOCK" />
 
     <application
         android:label="Buckdroid Roulette"
-- 
2.53.0.windows.2

