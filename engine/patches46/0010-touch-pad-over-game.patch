From 4db185800a2d62e58d31c7defba387176cc9db38 Mon Sep 17 00:00:00 2001
From: buckdroid <buckdroid@localhost>
Date: Tue, 24 Nov 2026 18:35:58 +0300
Subject: [PATCH] Buckdroid: on-screen buttons over the game (TouchPad) and the
 layout editor activity

---
 .../java/app/src/main/AndroidManifest.xml     |  6 +++++
 .../main/java/com/godot/game/GodotApp.java    | 25 +++++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/platform/android/java/app/src/main/AndroidManifest.xml b/platform/android/java/app/src/main/AndroidManifest.xml
index 47407bb..ee9765e 100644
--- a/platform/android/java/app/src/main/AndroidManifest.xml
+++ b/platform/android/java/app/src/main/AndroidManifest.xml
@@ -31,6 +31,12 @@
 
         <!-- Buckdroid: the launcher is the app's entry point; the engine runs in its own ":game" process, so leaving
              the game ends that process and the launcher stays. -->
+        <activity
+            android:name="com.buckdroid.roulette.TouchLayoutEditorActivity"
+            android:exported="false"
+            android:screenOrientation="sensorLandscape"
+            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
+            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden" />
         <activity
             android:name="com.buckdroid.roulette.LauncherActivity"
             android:label="Buckdroid Roulette"
diff --git a/platform/android/java/app/src/main/java/com/godot/game/GodotApp.java b/platform/android/java/app/src/main/java/com/godot/game/GodotApp.java
index 4bd7359..81d405e 100644
--- a/platform/android/java/app/src/main/java/com/godot/game/GodotApp.java
+++ b/platform/android/java/app/src/main/java/com/godot/game/GodotApp.java
@@ -35,6 +35,8 @@ import org.godotengine.godot.GodotActivity;
 
 import android.os.Bundle;
 import android.util.Log;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
 
 import androidx.activity.EdgeToEdge;
 import androidx.core.splashscreen.SplashScreen;
@@ -56,6 +58,9 @@ public class GodotApp extends GodotActivity {
 		}
 	}
 
+	// Buckdroid: the on-screen buttons (launcher/java TouchPad), null when controls.ini has touch_pad = off.
+	private com.buckdroid.roulette.TouchPad touchPad;
+
 	private final Runnable updateWindowAppearance = () -> {
 		Godot godot = getGodot();
 		if (godot != null) {
@@ -70,6 +75,23 @@ public class GodotApp extends GodotActivity {
 		SplashScreen.installSplashScreen(this);
 		EdgeToEdge.enable(this);
 		super.onCreate(savedInstanceState);
+		touchPad = com.buckdroid.roulette.TouchPad.attach(this);
+	}
+
+	@Override
+	public boolean dispatchKeyEvent(KeyEvent event) {
+		if (touchPad != null && com.buckdroid.roulette.TouchPad.isController(event.getSource())) {
+			touchPad.controllerUsed();
+		}
+		return super.dispatchKeyEvent(event);
+	}
+
+	@Override
+	public boolean dispatchGenericMotionEvent(MotionEvent event) {
+		if (touchPad != null && com.buckdroid.roulette.TouchPad.isController(event.getSource())) {
+			touchPad.controllerUsed();
+		}
+		return super.dispatchGenericMotionEvent(event);
 	}
 
 	@Override
@@ -82,6 +104,9 @@ public class GodotApp extends GodotActivity {
 	public void onGodotMainLoopStarted() {
 		super.onGodotMainLoopStarted();
 		runOnUiThread(updateWindowAppearance);
+		if (touchPad != null && getGodot() != null) {
+			touchPad.connect(getGodot());
+		}
 	}
 
 	@Override
-- 
2.53.0.windows.2

